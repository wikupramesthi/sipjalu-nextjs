{
  "name": "sipjalu-nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:next": "next build --webpack",
    "dev:vite": "vite --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/build-output.test.mjs && node --import tsx --test tests/unit.test.mjs",
    "check": "npm run typecheck && npm run test",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "electron-to-chromium": "1.5.395"
  }
}
