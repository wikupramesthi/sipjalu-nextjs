<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Database khusus testing (JANGAN pakai bekasikota asli!).
            RefreshDatabase akan migrate:fresh DB ini setiap test berjalan.
            Dibuat sekali via: CREATE DATABASE bekasikota_testing ...
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="bekasikota_testing"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="SCOUT_DRIVER" value="collection"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Jangan warisi API_PROXY_SECRET dari be/.env saat test. -->
        <env name="API_PROXY_SECRET" value=""/>
        <!-- Jangan warisi PUBLIC_API_KEY dari be/.env saat test. -->
        <env name="PUBLIC_API_KEY" value=""/>
        <!-- Test HTTP berjalan dari loopback; anggap itu proxy tepercaya. -->
        <env name="API_ALLOWED_PROXY_IPS" value="127.0.0.1"/>
    </php>
</phpunit>
