APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Token akses layar TV wallboard (/wallboard?token=...). Kosongkan = hanya user login.
# Token lewat query string tercatat di log akses — operasional harian prefer login user.
WALLBOARD_TOKEN=

# Origin frontend yang boleh memanggil /api/* (koma-separated, tanpa trailing slash).
# Production: ganti dengan domain asli, mis. https://agenda.example.go.id
# Web bekasikota.go.id ikut didaftar agar bisa fetch /api/v1/* dengan token.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8000,https://bekasikota.go.id,https://www.bekasikota.go.id

# Batasi /api agar hanya bisa diakses lewat proxy frontend (nginx FE).
# WAJIB isi string acak (huruf/angka); proxy FE mengirim header X-API-Proxy
# dengan nilai yang sama. Bila kosong, /api non-pengecualian DITOLAK.
API_PROXY_SECRET=
# Opsional: izinkan peer IP/CIDR tertentu tanpa header (kosong = wajib secret).
# Dipakai bila proxy tidak bisa menambahkan header; jangan isi rentang publik.
API_ALLOWED_PROXY_IPS=
# Default true: peer privat/loopback (RFC1918, ULA, link-local) dianggap proxy
# internal walau secret kosong/terisi. Set false untuk fail closed mutlak.
API_TRUST_PRIVATE_PEERS=true
# Route yang tetap boleh diakses langsung (klien login/API lain).
API_PROXY_EXEMPT_PREFIXES=api/auth,api/user,api/v1,api/opd

# Kunci API publik untuk endpoint baca SPA (header X-Api-Key).
# Kosong = middleware `public.key` meloloskan semua (cocok untuk lokal).
# Produksi: isi string acak dan samakan dengan VITE_PUBLIC_API_KEY di FE, mis.:
#     php -r "echo bin2hex(random_bytes(32));"
PUBLIC_API_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_INACTIVE_TIMEOUT=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Security (Keamanan)
SECURITY_MAX_LOGIN_ATTEMPTS=3
SECURITY_LOGIN_DECAY_MINUTES=10
SECURITY_LOGIN_LOCKOUT_MINUTES=5
SECURITY_ANOMALY_WINDOW_HOURS=24
SECURITY_ANOMALY_DISTINCT_IPS=3
SECURITY_ANOMALY_FAILED_ATTEMPTS=5

# IP/CIDR reverse-proxy tepercaya untuk X-Forwarded-* (koma-separated).
# Default aman = hanya localhost + RFC1918. JANGAN set '*' di produksi.
TRUSTED_PROXIES=

# Umur token Sanctum (menit). Default 1440 = 1 hari.
SANCTUM_TOKEN_EXPIRATION=1440

# Gateway WhatsApp untuk notifikasi agenda (kosongkan URL = hanya dicatat di log)
WA_ENABLED=false
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
